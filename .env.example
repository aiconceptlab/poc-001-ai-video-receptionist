# Copy to .env. Blank values enable the no-key local preview.
# DOMAIN-RESTRICTED CLIENT KEY from Agent > Embed, NOT your API key.
DID_AGENT_ID=
DID_CLIENT_KEY=
# expressive enables SDK microphone controls; classic uses typed input.
DID_AVATAR_TYPE=classic

# Optional. Used ONLY by the local setup script. Never exposed to the browser.
# Paste the exact credential AFTER "Basic " from D-ID's API example.
DID_API_KEY=

